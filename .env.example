# ==============================================================================
# Environment Selection
# Options: dev (development hot-reload) | prod (production runner)
# ==============================================================================
ENV=dev
FRONTEND_TARGET=dev

# ==============================================================================
# Database Target Selection
# Options: localdockerdb (local container) | cloud (Oracle Autonomous Cloud DB)
# When DB_TARGET=localdockerdb, Compose automatically includes the local Oracle container.
# When DB_TARGET=cloud, the local Oracle container is skipped.
# ==============================================================================
DB_TARGET=localdockerdb
COMPOSE_PROFILES=${DB_TARGET}

# Local Docker Database Credentials (used when DB_TARGET=localdockerdb)
ORACLE_LOCAL_USER=greenline_test
ORACLE_LOCAL_PASSWORD=test_password
ORACLE_LOCAL_DSN=oracle:1521/FREEPDB1

# Oracle Autonomous Cloud Database (used when DB_TARGET=cloud)
# Least-Privilege DML Application User (Recommended):
# Run `python services/networth/scripts/create_db_app_user.py` to provision GREENLINE_APP
ORACLE_CLOUD_USER=ADMIN
ORACLE_CLOUD_PASSWORD=replace-with-your-cloud-password
ORACLE_CLOUD_DSN=(description=(retry_count=20)(retry_delay=3)(address=(protocol=tcps)(port=1522)(host=adb.region.oraclecloud.com))(connect_data=(service_name=service_name_low.adb.oraclecloud.com))(security=(ssl_server_dn_match=yes)))
ORACLE_SCHEMA=ADMIN

# Networth & Analytics Microservice User (Optional cloud isolation):
# ORACLE_NETWORTH_USER=GREENLINE_NETWORTH
# ORACLE_NETWORTH_PASSWORD=replace-with-your-networth-password

# Community Microservice User (Cloud):
ORACLE_COMMUNITY_USER=GREENLINE_COMMUNITY
COMMUNITY_DB_PASSWORD=replace-with-your-community-password

# Local Oracle Free Test Container (used by pytest on host)
TEST_DATABASE_URL=oracle+oracledb://greenline_test:test_password@localhost:1521/?service_name=FREEPDB1

# Application Secrets & Authentication
SECRET_KEY=super-secret-investment-tracker-key-change-in-prod-2026
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASSWORD=admin123
NEXT_PUBLIC_API_URL=
REDIS_URL=redis://localhost:6379/0

# Performance & Diagnostic Timing
ENABLE_TIMING_LOGS=true
LOG_SQL_QUERIES=false
SLOW_QUERY_THRESHOLD_MS=50.0

# ==============================================================================
# Auth0 Production Authentication & Authorization
# ==============================================================================
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=http://localhost:8000
AUTH0_ISSUER=https://your-tenant.us.auth0.com/
AUTH0_ALGORITHMS=["RS256"]
AUTH0_TEST_MODE=false

# Frontend Auth0 Configuration
NEXT_PUBLIC_AUTH0_DOMAIN=your-tenant.us.auth0.com
NEXT_PUBLIC_AUTH0_CLIENT_ID=your-auth0-spa-client-id
NEXT_PUBLIC_AUTH0_AUDIENCE=http://localhost:8000
NEXT_PUBLIC_AUTH0_ENABLED=true
NEXT_PUBLIC_AUTH0_REDIRECT_URI=http://localhost:3000
