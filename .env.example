SECRET_KEY=super-secret-investment-tracker-key-change-in-prod-2026
# Oracle Database (Autonomous Database or Local Oracle Free)
DATABASE_URL=oracle+oracledb://@
# Least-Privilege DML Application User (Recommended):
# Run `python backend/scripts/create_db_app_user.py` to provision GREENLINE_APP
ORACLE_USER=GREENLINE_APP
ORACLE_PASSWORD=replace-with-your-app-password
ORACLE_SCHEMA=ADMIN

# Networth & Analytics Microservice User (Least-Privilege Isolation):
# Run `backend/scripts/setup_networth_user.sql` as ADMIN to provision GREENLINE_NETWORTH
# If unset, the Networth service falls back to ORACLE_USER and ORACLE_PASSWORD
ORACLE_NETWORTH_USER=GREENLINE_NETWORTH
ORACLE_NETWORTH_PASSWORD=replace-with-your-networth-password
# Alternatively, connect directly as schema owner (Full DDL permissions):
# ORACLE_USER=ADMIN
# ORACLE_PASSWORD=replace-with-your-admin-password
ORACLE_DSN=(description=(retry_count=20)(retry_delay=3)(address=(protocol=tcps)(port=1522)(host=adb.region.oraclecloud.com))(connect_data=(service_name=service_name_low.adb.oraclecloud.com))(security=(ssl_server_dn_match=yes)))

# Local Oracle Free Test Container (used by pytest)
TEST_DATABASE_URL=oracle+oracledb://greenline_test:test_password@localhost:1521/?service_name=FREEPDB1

DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASSWORD=admin123
NEXT_PUBLIC_API_URL=http://localhost:8000

# ==============================================================================
# Auth0 Production Authentication & Authorization
# ==============================================================================

# Backend Auth0 JWT RS256 Verification Settings
# Auth0 tenant domain (without protocol) used to fetch public JWKS keys (.well-known/jwks.json)
AUTH0_DOMAIN=your-tenant.us.auth0.com

# Target API audience / identifier configured in the Auth0 Dashboard under Applications > APIs
AUTH0_AUDIENCE=http://localhost:8000

# Canonical token issuer claim (iss) expected in verified JWT payloads (defaults to https://<AUTH0_DOMAIN>/)
AUTH0_ISSUER=https://your-tenant.us.auth0.com/

# Allowed signing algorithms for JWT token verification (Auth0 standard is RS256)
AUTH0_ALGORITHMS=["RS256"]

# Offline Test Mode: Set to true to bypass live network JWKS fetching and enable in-memory mock JWKS for automated tests
AUTH0_TEST_MODE=false

# Frontend Auth0 Configuration (Next.js client-side public environment variables)
# Auth0 tenant domain for the @auth0/auth0-react SPA SDK
NEXT_PUBLIC_AUTH0_DOMAIN=your-tenant.us.auth0.com

# Auth0 Single Page Application (SPA) Client ID created in Auth0 Dashboard under Applications > Applications
NEXT_PUBLIC_AUTH0_CLIENT_ID=your-auth0-spa-client-id

# API audience requested when obtaining RS256 access tokens silently for backend API requests
NEXT_PUBLIC_AUTH0_AUDIENCE=http://localhost:8000

# Redirect URI registered in Allowed Callback URLs in Auth0 Application Settings
NEXT_PUBLIC_AUTH0_REDIRECT_URI=http://localhost:3000
